# Каталог не в репозитории
#
# Он собирается из `site/` одной командой и целиком повторяем:
#   .venv\Scripts\python.exe tools\build_site.py
#
# Держать собранную копию в истории бессмысленно: она распухает
# до сотни мегабайт, а пользы не добавляет — изменили исходник,
# пересобрали, и всё.

site-dist/

# Временные картинки, которые накидываются в папку demo
#
# Здесь человек складывает баннеры, фоны и карточки для будущих
# сайтов. Это рабочий черновик на 120 МБ, а не исходник проекта:
# в истории git ему не место, и каждая правка увеличивала бы
# репозиторий навсегда.

site/demo/_assets/
site/demo/ДУБЛИ.txt

# Полные проекты с серверной частью
#
# В `site/full/` лежат исходники приложений, которым нужен сервер:
# Next.js, Prisma, API-роуты, база. На хостинг uCoz они не выкладываются
# (там нет серверного кода), и в истории git им тоже не место:
#
#   * только что выложенная папка занимает место навсегда — каждая
#     правка увеличивала бы репозиторий;
#   * внутри лежат `.env` с путями к базе и `node_modules`, которые
#     не должны попасть в публичный репозиторий;
#   * на витрине им всё равно нечего делать.
#
# Статичная версия каждого такого проекта лежит рядом, в `site/`,
# под именем `<проект>-static`, и вот она выкладывается как макет.
#
# Проверить, что ничего не уехало в репозиторий:
#   git ls-files site/full

site/full/

# То же самое на всякий случай: если проект с сервером положат не в
# `full/`, а рядом со статичной версией, в репозиторий он попасть
# не должен.
**/node_modules/
**/.next/
**/.env
**/.env.local
**/bun.lock
**/prisma/*.db
**/db/*.db

# Готовые архивы для публикации
publish/

# Сборки
*.zip
*.exe

# Служебное
__pycache__/
*.pyc
.pytest_cache/
*.log
.DS_Store
Thumbs.db

# Локальное окружение
.venv/
venv/

# Секреты
config/secrets.local.json
secrets.local.json
credentials.json
*.local.json

# Доступы к хостингу. Файл сам это оговаривает: «только для чтения
# агентами». Пароль от FTP в истории репозитория переживает отзыв
# доступа, а история остаётся навсегда.
FTP-dostup.txt

# файл с паролем от хостинга.
# Реестр сайтов под git, секрет из него убрать надо,
# а сам реестр коммитить можно и нужно.
ДОСТУПЫ*.txt

# --- Реестр и входы: добавлено 14 октября 2026, агент BUGFIX -------------
#
# В папке reestr лежат записи о сайтах, а внутри записей — логины и пароли,
# чтобы человек или агент мог войти и продолжить работу. Такое НЕЛЬЗЯ
# коммитить: пароль попадает в историю навсегда, и оттуда его уже не убрать.
# Раньше FTP-пароль утек в письмо проекта — повторять это через git не надо.
#
# Файлы остаются на диске и читаются как обычно. В git они не попадают.
reestr/
agent-connect/

# Любой файл с названием про доступ, на случай если он появится в другом месте
# или будет создан позже: правило должно работать и для будущих файлов.
**/*dostup*.txt
**/*доступ*.txt
**/*вход*.txt
**/*vhod*.txt
**/*login*.txt
**/*pass*.txt
**/*пароль*.txt
**/*secret*.txt
**/*credential*.txt
**/*token*.txt
